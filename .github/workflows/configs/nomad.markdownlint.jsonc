// https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
{
    // Set rules to disabled by default
    "default": false,

    // MD001 - Heading levels should only increment by one level at a time
    "MD001": true,
    // MD003 - Heading style
    "MD003": true,
    // MD004 - Unordered list style
    // TODO: maybe not necessary to enforce the same delimiters on different lists
    "MD004": false
}
